      "id": "5",
      "name": "Tickets Cerrados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Helper: flatten Supabase REST response into array of tickets\nfunction flatten(nodeItems) {\n  let result = [];\n  for (const item of nodeItems) {\n    if (Array.isArray(item.json)) result = result.concat(item.json);\n    else if (item.json && item.json.id) result.push(item.json);\n  }\n  return result;\n}\n\nconst open       = flatten($('Tickets Abiertos').all());\nconst inProgress = flatten($('Tickets En Progreso').all());\nconst resolved   = flatten($('Tickets Resueltos').all());\nconst closed     = flatten($('Tickets Cerrados').all());\n\nconst totalOpen       = open.length;\nconst totalInProgress = inProgress.length;\nconst totalResolved   = resolved.length;\nconst totalClosed     = closed.length;\nconst totalAll        = totalOpen + totalInProgress + totalResolved + totalClosed;\nconst totalActive     = totalOpen + totalInProgress;\n\n// Priority breakdown across ALL active tickets\nconst byPriority = { critical: 0, high: 0, medium: 0, low: 0 };\nfor (const t of [...open, ...inProgress]) {\n  const p = t.priority || 'medium';\n  if (byPriority[p] !== undefined) byPriority[p]++;\n}\n\n// Resolution rate = (resolved + closed) / total\nconst resolutionRate = totalAll > 0 ? Math.round(((totalResolved + totalClosed) / totalAll) * 100) : 0;\n\n// Unassigned open tickets\nconst unassigned = open.filter(t => !t.assigned_to).length;\n\n// Overdue: open tickets older than 24h\nconst now = new Date();\nconst overdue = open.filter(t => (now - new Date(t.created_at)) > 86400000).length;\n\n// Sentiment breakdown across ALL tickets\nconst allTickets = [...open, ...inProgress, ...resolved, ...closed];\nconst bySentiment = { angry: 0, negative: 0, neutral: 0, positive: 0 };\nfor (const t of allTickets) {\n  const s = t.sentiment || 'neutral';\n  if (bySentiment[s] !== undefined) bySentiment[s]++;\n}\n\n// Priority bar widths (% of active tickets)\nconst maxBar = totalActive > 0 ? totalActive : 1;\nconst bars = {\n  critical: Math.round((byPriority.critical / maxBar) * 100),\n  high:     Math.round((byPriority.high     / maxBar) * 100),\n  medium:   Math.round((byPriority.medium   / maxBar) * 100),\n  low:      Math.round((byPriority.low      / maxBar) * 100)\n};\n\nconst today = new Date().toLocaleDateString('es-ES', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',\n  timeZone: 'America/New_York'\n});\n\nreturn [{\n  json: {\n    date: today,\n    total_open: totalOpen,\n    total_in_progress: totalInProgress,\n    total_resolved: totalResolved,\n    total_closed: totalClosed,\n    total_all: totalAll,\n    total_active: totalActive,\n    resolution_rate: resolutionRate,\n    unassigned: unassigned,\n    overdue_tickets: overdue,\n    by_priority: byPriority,\n    bars: bars,\n    by_sentiment: bySentiment\n  }\n}];"
      },
      "id": "6",
      "name": "Calcular Metricas",
