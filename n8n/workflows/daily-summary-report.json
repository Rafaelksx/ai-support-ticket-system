        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/tickets?status=eq.closed&select=id,priority,sentiment,created_at,updated_at",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
