        "subject": "=📊 Reporte Diario · {{ $json.date }}",
        "emailType": "html",
        "message": "=Reporte diario AuraSupport: {{ $json.total_open }} abiertos, {{ $json.total_in_progress }} en progreso, {{ $json.total_resolved }} resueltos, {{ $json.total_closed }} cerrados. Tasa de resolucion: {{ $json.resolution_rate }}%.",
        "html": "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"></head><body style=\"margin:0;padding:0;font-family:Arial,sans-serif;\" bgcolor=\"#eef2f7\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"#eef2f7\"><tr><td align=\"center\" style=\"padding:32px 16px;\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\"><!-- HEADER --><tr><td bgcolor=\"#1e293b\" align=\"center\" style=\"padding:36px 40px;\"><p style=\"margin:0 0 4px;font-size:11px;color:#a5b4fc;font-weight:bold;text-transform:uppercase;letter-spacing:2px;\">AuraSupport &middot; Reporte Automatico</p><h1 style=\"margin:8px 0 4px;font-size:26px;font-weight:bold;color:#ffffff;\">Reporte Diario</h1><p style=\"margin:0;font-size:14px;color:#94a3b8;\">{{ $json.date }}</p></td></tr><!-- GAP --><tr><td bgcolor=\"#ffffff\" style=\"padding:24px 28px 8px;\"><!-- STATUS CARDS --><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"25%\" style=\"padding:4px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#dbeafe\" align=\"center\" style=\"padding:16px 6px;\"><p style=\"margin:0;font-size:26px;font-weight:bold;color:#1d4ed8;\">{{ $json.total_open }}</p><p style=\"margin:6px 0 0;font-size:10px;font-weight:bold;color:#2563eb;text-transform:uppercase;letter-spacing:1px;\">Abiertos</p></td></tr></table></td><td width=\"25%\" style=\"padding:4px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#fed7aa\" align=\"center\" style=\"padding:16px 6px;\"><p style=\"margin:0;font-size:26px;font-weight:bold;color:#c2410c;\">{{ $json.total_in_progress }}</p><p style=\"margin:6px 0 0;font-size:10px;font-weight:bold;color:#ea580c;text-transform:uppercase;letter-spacing:1px;\">En Progreso</p></td></tr></table></td><td width=\"25%\" style=\"padding:4px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#bbf7d0\" align=\"center\" style=\"padding:16px 6px;\"><p style=\"margin:0;font-size:26px;font-weight:bold;color:#15803d;\">{{ $json.total_resolved }}</p><p style=\"margin:6px 0 0;font-size:10px;font-weight:bold;color:#16a34a;text-transform:uppercase;letter-spacing:1px;\">Resueltos</p></td></tr></table></td><td width=\"25%\" style=\"padding:4px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#e2e8f0\" align=\"center\" style=\"padding:16px 6px;\"><p style=\"margin:0;font-size:26px;font-weight:bold;color:#475569;\">{{ $json.total_closed }}</p><p style=\"margin:6px 0 0;font-size:10px;font-weight:bold;color:#64748b;text-transform:uppercase;letter-spacing:1px;\">Cerrados</p></td></tr></table></td></tr></table></td></tr><!-- RESOLUTION BAR --><tr><td bgcolor=\"#ffffff\" style=\"padding:16px 28px 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#6366f1\" style=\"padding:18px 22px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><span style=\"color:#e0e7ff;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:1px;\">Tasa de Resolucion Global</span></td><td align=\"right\"><span style=\"color:#ffffff;font-size:22px;font-weight:bold;\">{{ $json.resolution_rate }}%</span></td></tr><tr><td colspan=\"2\" style=\"padding-top:10px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#ffffff\" width=\"{{ $json.resolution_rate }}%\" height=\"8\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td><td bgcolor=\"#818cf8\" height=\"8\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td></tr></table></td></tr><tr><td colspan=\"2\" style=\"padding-top:8px;\"><span style=\"color:#c7d2fe;font-size:12px;\">{{ $json.total_resolved + $json.total_closed }} de {{ $json.total_all }} tickets completados</span></td></tr></table></td></tr></table></td></tr><!-- PRIORITY --><tr><td bgcolor=\"#ffffff\" style=\"padding:16px 28px 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f8fafc\" style=\"padding:18px 22px;border:1px solid #e2e8f0;\"><p style=\"margin:0 0 14px;font-size:14px;font-weight:bold;color:#1e293b;\">Prioridad de Tickets Activos</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:4px 0;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"80\" style=\"font-size:12px;color:#64748b;\">Critico</td><td style=\"padding:0 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#ef4444\" width=\"{{ $json.bars.critical > 0 ? $json.bars.critical : 2 }}%\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td><td bgcolor=\"#fee2e2\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td></tr></table></td><td width=\"28\" align=\"right\" style=\"font-size:13px;font-weight:bold;color:#dc2626;\">{{ $json.by_priority.critical }}</td></tr></table></td></tr><tr><td style=\"padding:4px 0;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"80\" style=\"font-size:12px;color:#64748b;\">Alta</td><td style=\"padding:0 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f97316\" width=\"{{ $json.bars.high > 0 ? $json.bars.high : 2 }}%\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td><td bgcolor=\"#ffedd5\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td></tr></table></td><td width=\"28\" align=\"right\" style=\"font-size:13px;font-weight:bold;color:#ea580c;\">{{ $json.by_priority.high }}</td></tr></table></td></tr><tr><td style=\"padding:4px 0;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"80\" style=\"font-size:12px;color:#64748b;\">Media</td><td style=\"padding:0 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#3b82f6\" width=\"{{ $json.bars.medium > 0 ? $json.bars.medium : 2 }}%\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td><td bgcolor=\"#dbeafe\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td></tr></table></td><td width=\"28\" align=\"right\" style=\"font-size:13px;font-weight:bold;color:#2563eb;\">{{ $json.by_priority.medium }}</td></tr></table></td></tr><tr><td style=\"padding:4px 0;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"80\" style=\"font-size:12px;color:#64748b;\">Baja</td><td style=\"padding:0 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#22c55e\" width=\"{{ $json.bars.low > 0 ? $json.bars.low : 2 }}%\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td><td bgcolor=\"#dcfce7\" height=\"10\" style=\"font-size:1px;line-height:1px;\">&nbsp;</td></tr></table></td><td width=\"28\" align=\"right\" style=\"font-size:13px;font-weight:bold;color:#16a34a;\">{{ $json.by_priority.low }}</td></tr></table></td></tr></table></td></tr></table></td></tr><!-- SENTIMENT --><tr><td bgcolor=\"#ffffff\" style=\"padding:16px 28px 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f8fafc\" style=\"padding:18px 22px;border:1px solid #e2e8f0;\"><p style=\"margin:0 0 14px;font-size:14px;font-weight:bold;color:#1e293b;\">Sentimiento del Usuario</p><table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\"><tr><td width=\"25%\" align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#fef2f2\" align=\"center\" style=\"padding:12px 4px;\"><p style=\"margin:0;font-size:20px;font-weight:bold;color:#dc2626;\">{{ $json.by_sentiment.angry }}</p><p style=\"margin:4px 0 0;font-size:11px;color:#94a3b8;\">Enojado</p></td></tr></table></td><td width=\"25%\" align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#fff7ed\" align=\"center\" style=\"padding:12px 4px;\"><p style=\"margin:0;font-size:20px;font-weight:bold;color:#ea580c;\">{{ $json.by_sentiment.negative }}</p><p style=\"margin:4px 0 0;font-size:11px;color:#94a3b8;\">Negativo</p></td></tr></table></td><td width=\"25%\" align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f1f5f9\" align=\"center\" style=\"padding:12px 4px;\"><p style=\"margin:0;font-size:20px;font-weight:bold;color:#64748b;\">{{ $json.by_sentiment.neutral }}</p><p style=\"margin:4px 0 0;font-size:11px;color:#94a3b8;\">Neutro</p></td></tr></table></td><td width=\"25%\" align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#f0fdf4\" align=\"center\" style=\"padding:12px 4px;\"><p style=\"margin:0;font-size:20px;font-weight:bold;color:#16a34a;\">{{ $json.by_sentiment.positive }}</p><p style=\"margin:4px 0 0;font-size:11px;color:#94a3b8;\">Positivo</p></td></tr></table></td></tr></table></td></tr></table></td></tr><!-- ALERTS --><tr><td bgcolor=\"#ffffff\" style=\"padding:16px 28px 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td bgcolor=\"#fef9c3\" style=\"padding:18px 20px;border:1px solid #fcd34d;\"><p style=\"margin:0 0 8px;font-size:13px;font-weight:bold;color:#92400e;\">Alertas del Dia</p><p style=\"margin:0;font-size:13px;color:#78350f;line-height:1.7;\">{{ $json.unassigned > 0 ? $json.unassigned + ' ticket(s) sin asignar' : 'Todos los tickets tienen agente asignado' }}<br>{{ $json.overdue_tickets > 0 ? $json.overdue_tickets + ' ticket(s) llevan mas de 24h abiertos' : 'Ningun ticket supera las 24h sin atencion' }}</p></td></tr></table></td></tr><!-- CTA --><tr><td bgcolor=\"#ffffff\" align=\"center\" style=\"padding:24px 28px 28px;\"><a href=\"https://ai-support-ticket-system-lac.vercel.app\" style=\"display:inline-block;background-color:#6366f1;color:#ffffff;text-decoration:none;padding:14px 40px;font-size:15px;font-weight:bold;\">Ver Dashboard Completo</a></td></tr><!-- FOOTER --><tr><td bgcolor=\"#1e293b\" align=\"center\" style=\"padding:18px 32px;\"><p style=\"margin:0;font-size:12px;color:#64748b;\">AuraSupport &middot; Reporte Automatico Diario