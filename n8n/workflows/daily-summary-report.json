        }
      },
      "id": "get-critical-tickets",
      "name": "Obtener Tickets Críticos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 600]
    },
    {
      "parameters": {
        "jsCode": "// Recopilar datos de los tres nodos anteriores\nconst openData = $('Obtener Tickets Abiertos').first().json;\nconst resolvedData = $('Obtener Tickets Resueltos').first().json;\nconst criticalData = $('Obtener Tickets Críticos').first().json;\n\nconst openTickets = openData?.data?.tickets || [];\nconst resolvedTickets = resolvedData?.data?.tickets || [];\nconst criticalTickets = criticalData?.data?.tickets || [];\n\n// Métricas\nconst totalOpen = openData?.data?.pagination?.total || openTickets.length;\nconst totalResolved = resolvedData?.data?.pagination?.total || resolvedTickets.length;\nconst totalCritical = criticalData?.data?.pagination?.total || criticalTickets.length;\n\n// Distribución por prioridad (tickets abiertos)\nconst byPriority = { low: 0, medium: 0, high: 0, critical: 0 };\nfor (const t of openTickets) {\n  if (byPriority[t.priority] !== undefined) byPriority[t.priority]++;\n}\n\n// Distribución por sentimiento\nconst bySentiment = { positive: 0, neutral: 0, negative: 0, angry: 0 };\nfor (const t of openTickets) {\n  if (t.ai_sentiment && bySentiment[t.ai_sentiment] !== undefined) {\n    bySentiment[t.ai_sentiment]++;\n  }\n}\n\n// Tickets sin asignar\nconst unassigned = openTickets.filter(t => !t.assigned_to).length;\n\n// Top 5 tickets críticos o de alta prioridad\nconst topUrgent = [...openTickets]\n  .filter(t => t.priority === 'critical' || t.priority === 'high')\n  .sort((a, b) => new Date(a.created_at) - new Date(b.created_at))\n  .slice(0, 5);\n\n// Fecha de hoy\nconst today = new Date();\nconst dateStr = today.toLocaleDateString('es-ES', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'\n});\n\n// SLA simple: tickets abiertos > 24h\nconst overdueTickets = openTickets.filter(t => {\n  const created = new Date(t.created_at);\n  const diffHours = (today - created) / (1000 * 60 * 60);\n  return diffHours > 24;\n}).length;\n\nreturn [{\n  json: {\n    date: dateStr,\n    total_open: totalOpen,\n    total_resolved: totalResolved,\n    total_critical: totalCritical,\n    unassigned: unassigned,\n    overdue_tickets: overdueTickets,\n    resolution_rate: totalResolved > 0 ? Math.round((totalResolved / (totalOpen + totalResolved)) * 100) : 0,\n    by_priority: byPriority,\n    by_sentiment: bySentiment,\n    top_urgent: topUrgent,\n    app_url: $env.NEXT_PUBLIC_APP_URL || 'https://your-app.vercel.app'\n  }\n}];"
      },
      "id": "compute-metrics",
      "name": "Calcular Métricas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 400]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.REPORT_EMAIL || 'admin@company.com' }}",
        "subject": "📊 Reporte Diario de Soporte - {{ $json.date }}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Reporte Diario</title>\n</head>\n<body style=\"margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif;background:#f0f2f5;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f0f2f5;padding:40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"660\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background:linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#334155 100%);padding:40px;text-align:center;\">\n              <h1 style=\"color:#fff;margin:0 0 4px;font-size:26px;font-weight:700;\">📊 Reporte Diario</h1>\n              <p style=\"color:#94a3b8;margin:0;font-size:14px;\">{{ $json.date }}</p>\n              <div style=\"margin-top:16px;display:inline-block;background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.4);border-radius:20px;padding:4px 16px;\">\n                <span style=\"color:#a5b4fc;font-size:13px;font-weight:600;\">AuraSupport · Sistema de Soporte con IA</span>\n              </div>\n            </td>\n          </tr>\n\n          <!-- KPI Cards -->\n          <tr>\n            <td style=\"padding:32px 40px 0;\">\n              <h2 style=\"color:#1e293b;font-size:16px;margin:0 0 16px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;\">📈 Métricas Clave</h2>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"8\">\n                <tr>\n                  <td width=\"25%\" style=\"padding:4px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eff6ff;border-radius:10px;border:1px solid #bfdbfe;\">\n                      <tr>\n                        <td style=\"padding:16px;text-align:center;\">\n                          <div style=\"font-size:28px;font-weight:800;color:#1d4ed8;\">{{ $json.total_open }}</div>\n                          <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;margin-top:4px;\">Abiertos</div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td width=\"25%\" style=\"padding:4px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f0fdf4;border-radius:10px;border:1px solid #bbf7d0;\">\n                      <tr>\n                        <td style=\"padding:16px;text-align:center;\">\n                          <div style=\"font-size:28px;font-weight:800;color:#15803d;\">{{ $json.total_resolved }}</div>\n                          <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;margin-top:4px;\">Resueltos</div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td width=\"25%\" style=\"padding:4px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fef2f2;border-radius:10px;border:1px solid #fecaca;\">\n                      <tr>\n                        <td style=\"padding:16px;text-align:center;\">\n                          <div style=\"font-size:28px;font-weight:800;color:#dc2626;\">{{ $json.total_critical }}</div>\n                          <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;margin-top:4px;\">Críticos</div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td width=\"25%\" style=\"padding:4px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f5f3ff;border-radius:10px;border:1px solid #ddd6fe;\">\n                      <tr>\n                        <td style=\"padding:16px;text-align:center;\">\n                          <div style=\"font-size:28px;font-weight:800;color:#7c3aed;\">{{ $json.resolution_rate }}%</div>\n                          <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;margin-top:4px;\">Resolución</div>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Alertas -->\n              {{ $json.unassigned > 0 || $json.overdue_tickets > 0 ? `\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;margin-top:16px;\">\n                <tr><td style=\"padding:14px 18px;\">\n                  <strong style=\"color:#92400e;\">⚠️ Alertas del día:</strong>\n                  <ul style=\"margin:6px 0 0;padding-left:20px;color:#78350f;font-size:13px;\">\n                    ${$json.unassigned > 0 ? `<li>${$json.unassigned} ticket(s) sin asignar</li>` : ''}\n                    ${$json.overdue_tickets > 0 ? `<li>${$json.overdue_tickets} ticket(s) con más de 24h sin resolución</li>` : ''}\n                  </ul>\n                </td></tr>\n              </table>` : '' }}\n            </td>\n          </tr>\n\n          <!-- Distribución por Prioridad -->\n          <tr>\n            <td style=\"padding:24px 40px 0;\">\n              <h2 style=\"color:#1e293b;font-size:16px;margin:0 0 12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;\">🎯 Distribución por Prioridad</h2>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;\">\n                <tr style=\"background:#f8fafc;\">\n                  <th style=\"padding:10px 16px;text-align:left;font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;\">Prioridad</th>\n                  <th style=\"padding:10px 16px;text-align:center;font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;\">Tickets</th>\n                  <th style=\"padding:10px 16px;text-align:left;font-size:12px;color:#64748b;font-weight:700;text-transform:uppercase;\">Barra</th>\n                </tr>\n                <tr style=\"border-top:1px solid #e2e8f0;\">\n                  <td style=\"padding:10px 16px;font-size:13px;font-weight:600;color:#dc2626;\">🔴 Crítico</td>\n                  <td style=\"padding:10px 16px;text-align:center;font-size:13px;font-weight:700;color:#dc2626;\">{{ $json.by_priority.critical }}</td>\n                  <td style=\"padding:10px 16px;\"><div style=\"background:#dc2626;height:8px;border-radius:4px;width:{{ Math.min(($json.by_priority.critical / Math.max($json.total_open, 1)) * 200, 200) }}px;\"></div></td>\n                </tr>\n                <tr style=\"border-top:1px solid #e2e8f0;background:#fafafa;\">\n                  <td style=\"padding:10px 16px;font-size:13px;font-weight:600;color:#d97706;\">🟠 Alta</td>\n                  <td style=\"padding:10px 16px;text-align:center;font-size:13px;font-weight:700;color:#d97706;\">{{ $json.by_priority.high }}</td>\n                  <td style=\"padding:10px 16px;\"><div style=\"background:#f59e0b;height:8px;border-radius:4px;width:{{ Math.min(($json.by_priority.high / Math.max($json.total_open, 1)) * 200, 200) }}px;\"></div></td>\n                </tr>\n                <tr style=\"border-top:1px solid #e2e8f0;\">\n                  <td style=\"padding:10px 16px;font-size:13px;font-weight:600;color:#2563eb;\">🔵 Media</td>\n                  <td style=\"padding:10px 16px;text-align:center;font-size:13px;font-weight:700;color:#2563eb;\">{{ $json.by_priority.medium }}</td>\n                  <td style=\"padding:10px 16px;\"><div style=\"background:#3b82f6;height:8px;border-radius:4px;width:{{ Math.min(($json.by_priority.medium / Math.max($json.total_open, 1)) * 200, 200) }}px;\"></div></td>\n                </tr>\n                <tr style=\"border-top:1px solid #e2e8f0;background:#fafafa;\">\n                  <td style=\"padding:10px 16px;font-size:13px;font-weight:600;color:#16a34a;\">🟢 Baja</td>\n                  <td style=\"padding:10px 16px;text-align:center;font-size:13px;font-weight:700;color:#16a34a;\">{{ $json.by_priority.low }}</td>\n                  <td style=\"padding:10px 16px;\"><div style=\"background:#22c55e;height:8px;border-radius:4px;width:{{ Math.min(($json.by_priority.low / Math.max($json.total_open, 1)) * 200, 200) }}px;\"></div></td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Sentimiento -->\n          <tr>\n            <td style=\"padding:24px 40px 0;\">\n              <h2 style=\"color:#1e293b;font-size:16px;margin:0 0 12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;\">💬 Análisis de Sentimiento (IA)</h2>\n              <table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;\">\n                <tr style=\"background:#f8fafc;\">\n                  <td style=\"font-size:13px;font-weight:600;color:#dc2626;\">😡 Enojado: <strong>{{ $json.by_sentiment.angry }}</strong></td>\n                  <td style=\"font-size:13px;font-weight:600;color:#f97316;\">😞 Negativo: <strong>{{ $json.by_sentiment.negative }}</strong></td>\n                  <td style=\"font-size:13px;font-weight:600;color:#64748b;\">😐 Neutro: <strong>{{ $json.by_sentiment.neutral }}</strong></td>\n                  <td style=\"font-size:13px;font-weight:600;color:#16a34a;\">😊 Positivo: <strong>{{ $json.by_sentiment.positive }}</strong></td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- CTA -->\n          <tr>\n            <td style=\"padding:28px 40px;text-align:center;\">\n              <a href=\"{{ $json.app_url }}/dashboard\" style=\"display:inline-block;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;text-decoration:none;padding:14px 36px;border-radius:8px;font-size:15px;font-weight:600;\">📊 Ver Dashboard Completo</a>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background:#f8fafc;padding:20px 40px;border-top:1px solid #e2e8f0;text-align:center;\">\n              <p style=\"color:#94a3b8;font-size:12px;margin:0;\">© {{ new Date().getFullYear() }} AuraSupport · Reporte Automático Diario · 8:00 AM</p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
