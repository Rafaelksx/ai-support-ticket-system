x;margin-top:4px;\">Urgentes</div></div></td><td width=\"25%\" align=\"center\" style=\"padding:8px;\"><div style=\"background:#faf5ff;border-radius:12px;padding:16px 8px;\"><div style=\"font-size:28px;font-weight:700;color:#7c3aed;\">{{ $json.resolution_rate }}%</div><div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;margin-top:4px;\">Resolucion</div></div></td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;\"><tr><td style=\"padding:20px 24px;\"><h3 style=\"color:#1e293b;margin:0 0 16px;font-size:15px;\">🎯 Distribución por Prioridad</h3><table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\"><tr><td style=\"color:#64748b;font-size:13px;\">🔴 Crítico</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_priority.critical }}</td></tr><tr><td style=\"color:#64748b;font-size:13px;\">🟠 Alta</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_priority.high }}</td></tr><tr><td style=\"color:#64748b;font-size:13px;\">🔵 Media</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_priority.medium }}</td></tr><tr><td style=\"color:#64748b;font-size:13px;\">🟢 Baja</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_priority.low }}</td></tr></table></td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;\"><tr><td style=\"padding:20px 24px;\"><h3 style=\"color:#1e293b;margin:0 0 16px;font-size:15px;\">💬 Sentimiento del Usuario</h3><table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\"><tr><td style=\"color:#64748b;font-size:13px;\">😡 Enojado</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_sentiment.angry }}</td></tr><tr><td style=\"color:#64748b;font-size:13px;\">😞 Negativo</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_sentiment.negative }}</td></tr><tr><td style=\"color:#64748b;font-size:13px;\">😐 Neutro</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_sentiment.neutral }}</td></tr><tr><td style=\"color:#64748b;font-size:13px;\">😊 Positivo</td><td align=\"right\" style=\"font-weight:700;color:#1e293b;font-size:13px;\">{{ $json.by_sentiment.positive }}</td></tr></table></td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff7ed;border-radius:12px;border:1px solid #fed7aa;margin-bottom:24px;\"><tr><td style=\"padding:16px 24px;\"><h3 style=\"color:#c2410c;margin:0 0 8px;font-size:14px;\">⚠️ Alertas</h3><p style=\"color:#475569;font-size:13px;margin:0;line-height:1.6;\">{{ $json.unassigned }} ticket(s) sin asignar · {{ $json.overdue_tickets }} ticket(s) con mas de 24h abiertos</p></td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\"><a href=\"https://ai-support-ticket-system-lac.vercel.app\" style=\"display:inline-block;background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;text-decoration:none;padding:14px 36px;border-radius:10px;font-size:15px;font-weight:600;\">📋 Ir al Dashboard</a></td></tr></table></td></tr><tr><td style=\"background:#f8fafc;padding:20px 40px;border-top:1px solid #e2e8f0;text-align:center;\"><p style=\"color:#94a3b8;font-size:12px;margin:0;\">© 2025 AuraSupport · Reporte Automatico Diario</p></td></tr></table></td></tr></table></body></html>",
