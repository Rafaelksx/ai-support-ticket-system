    {
      "parameters": {
        "jsCode": "// Get data from previous nodes\nconst openTicketsRaw = $('Obtener Tickets Abiertos').all();\nconst resolvedTicketsRaw = $('Obtener Tickets Resueltos').all();\n\n// Flatten: each HTTP node returns items, each item.json may be a ticket or an array\nlet openTickets = [];\nfor (const item of openTicketsRaw) {\n  if (Array.isArray(item.json)) {\n    openTickets = openTickets.concat(item.json);\n  } else if (item.json && item.json.id) {\n    openTickets.push(item.json);\n  }\n}\n\nlet resolvedTickets = [];\nfor (const item of resolvedTicketsRaw) {\n  if (Array.isArray(item.json)) {\n    resolvedTickets = resolvedTickets.concat(item.json);\n  } else if (item.json && item.json.id) {\n    resolvedTickets.push(item.json);\n  }\n}\n\nconst totalOpen = openTickets.length;\nconst totalResolved = resolvedTickets.length;\nconst totalAll = totalOpen + totalResolved;\n\n// Count by priority\nconst byPriority = { critical: 0, high: 0, medium: 0, low: 0 };\nfor (const t of openTickets) {\n  const p = t.priority || 'medium';\n  if (byPriority[p] !== undefined) byPriority[p]++;\n}\n\n// Count critical (open)\nconst totalCritical = byPriority.critical + byPriority.high;\n\n// Count unassigned\nconst unassigned = openTickets.filter(t => !t.assigned_to).length;\n\n// Count overdue (open > 24h)\nconst now = new Date();\nconst overdue = openTickets.filter(t => {\n  const created = new Date(t.created_at);\n  return (now - created) > 24 * 60 * 60 * 1000;\n}).length;\n\n// Sentiment counts from open tickets\nconst bySentiment = { angry: 0, negative: 0, neutral: 0, positive: 0 };\nfor (const t of openTickets) {\n  const s = t.sentiment || 'neutral';\n  if (bySentiment[s] !== undefined) bySentiment[s]++;\n}\n\n// Resolution rate\nconst resolutionRate = totalAll > 0 ? Math.round((totalResolved / totalAll) * 100) : 0;\n\nconst today = new Date().toLocaleDateString('es-ES', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  timeZone: 'America/New_York'\n});\n\nreturn [{\n  json: {\n    date: today,\n    total_open: totalOpen,\n    total_resolved: totalResolved,\n    total_critical: totalCritical,\n    resolution_rate: resolutionRate,\n    unassigned: unassigned,\n    overdue_tickets: overdue,\n    by_priority: byPriority,\n    by_sentiment: bySentiment\n  }\n}];"
      },
      "id": "4",
      "name": "Calcular Metricas",
      "type": "n8n-nodes-base.code",
