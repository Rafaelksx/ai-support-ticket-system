{
  "name": "Ticket Creado - Email Confirmación",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ticket-created",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ticket-created"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst priorityLabels = {\n  critical: '🔴 Crítico',\n  high: '🟠 Alta',\n  medium: '🔵 Media',\n  low: '🟢 Baja'\n};\n\nreturn [{\n  json: {\n    ticket_id: body.ticket_id || 'N/A',\n    ticket_short: (body.ticket_id || 'N/A').substring(0, 8),\n    title: body.title || 'Sin título',\n    description: (body.description || '').substring(0, 200),\n    priority: body.priority || 'medium',\n    priority_label: priorityLabels[body.priority] || '🔵 Media',\n    category: body.category || 'General',\n    user_email: body.user_email || '',\n    user_name: body.user_name || 'Usuario',\n    created_at: new Date().toLocaleString('es-ES', { timeZone: 'America/New_York' }),\n    app_url: 'https://ai-support-ticket-system-lac.vercel.app'\n  }\n}];"
      },
      "id": "2",
      "name": "Preparar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.user_email }}",
        "subject": "=✅ Tu ticket #{{ $json.ticket_short }} ha sido creado - AuraSupport",
        "emailType": "html",
        "message": "=Tu ticket #{{ $json.ticket_short }} ha sido creado exitosamente. Titulo: {{ $json.title }}. Prioridad: {{ $json.priority_label }}. Puedes ver el estado de tu ticket en: {{ $json.app_url }}/tickets/{{ $json.ticket_id }}",
        "html": "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"></head><body style=\"margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif;background-color:#f0f2f5;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f0f2f5;padding:40px 20px;\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);\"><tr><td style=\"background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a78bfa 100%);padding:40px;text-align:center;\"><h1 style=\"color:#fff;margin:0;font-size:26px;font-weight:700;\">🎫 AuraSupport</h1><p style=\"color:rgba(255,255,255,0.85);margin:8px 0 0;font-size:14px;\">Sistema de Soporte Inteligente</p></td></tr><tr><td style=\"padding:36px 40px;\"><h2 style=\"color:#1e293b;margin:0 0 8px;font-size:20px;\">¡Tu ticket ha sido recibido!</h2><p style=\"color:#64748b;margin:0 0 24px;font-size:15px;line-height:1.6;\">Hola <strong>{{ $json.user_name }}</strong>, hemos recibido tu solicitud y nuestro equipo la revisará pronto.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;\"><tr><td style=\"padding:20px 24px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:6px 0;\"><span style=\"color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:600;\">ID del Ticket</span><br><span style=\"color:#1e293b;font-size:15px;font-weight:700;font-family:monospace;\">#{{ $json.ticket_short }}</span></td><td style=\"padding:6px 0;\" align=\"right\"><span style=\"background:#dbeafe;color:#2563eb;padding:4px 14px;border-radius:20px;font-size:12px;font-weight:700;\">{{ $json.priority_label }}</span></td></tr><tr><td colspan=\"2\" style=\"padding:14px 0 6px;border-top:1px solid #e2e8f0;\"><span style=\"color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:600;\">Título</span><br><span style=\"color:#1e293b;font-size:15px;font-weight:500;\">{{ $json.title }}</span></td></tr><tr><td style=\"padding:10px 0 6px;\"><span style=\"color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:600;\">Categoría</span><br><span style=\"color:#1e293b;font-size:14px;\">{{ $json.category }}</span></td><td style=\"padding:10px 0 6px;\"><span style=\"color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:1px;font-weight:600;\">Fecha</span><br><span style=\"color:#1e293b;font-size:14px;\">{{ $json.created_at }}</span></td></tr></table></td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding-bottom:24px;\"><a href=\"{{ $json.app_url }}/tickets/{{ $json.ticket_id }}\" style=\"display:inline-block;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;text-decoration:none;padding:14px 36px;border-radius:10px;font-size:15px;font-weight:600;\">📋 Ver mi Ticket</a></td></tr></table><p style=\"color:#94a3b8;font-size:13px;line-height:1.6;margin:0;\">Si no creaste este ticket, puedes ignorar este email.</p></td></tr><tr><td style=\"background:#f8fafc;padding:20px 40px;border-top:1px solid #e2e8f0;text-align:center;\"><p style=\"color:#94a3b8;font-size:12px;margin:0;\">© 2025 AuraSupport · Sistema de Soporte con IA</p></td></tr></table></td></tr></table></body></html>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "3",
      "name": "Enviar Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [720, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":true,\"message\":\"Email de confirmacion enviado\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "4",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 300]
    }
  ],
