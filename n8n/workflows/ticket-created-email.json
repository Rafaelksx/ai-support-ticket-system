{
  "name": "Ticket Creado - Email de Confirmación",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ticket-created",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Recibir Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ticket-created-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "secret-check",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $vars.N8N_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-secret",
      "name": "Validar Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ .error.: .Unauthorized., .message.: .Invalid webhook secret. }",
        "options": {
          "responseCode": 401
        }
      },
      "id": "unauthorized-response",
      "name": "Respuesta No Autorizada",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 500]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;..return [{.  json: {.    ticket_id: body.ticket_id || 'N/A',.    title: body.title || 'Sin título',.    description: body.description || '',.    priority: body.priority || 'medium',.    category: body.category || 'General',.    user_email: body.user_email || '',.    user_name: body.user_name || 'Usuario',.    created_at: new Date().toISOString(),.    app_url: $vars.NEXT_PUBLIC_APP_URL || 'https://your-app.vercel.app'.  }.}];"
      },
      "id": "parse-payload",
      "name": "Parsear Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.user_email }}",
        "subject": "✅ Tu ticket #{{ $json.ticket_id.substring(0, 8) }} ha sido creado - AuraSupport",
        "emailType": "html",
        "message": "<!DOCTYPE html>.<html lang=.es.>.<head>.  <meta charset=.UTF-8.>.  <meta name=.viewport. content=.width=device-width, initial-scale=1.0.>.  <title>Ticket Creado</title>.</head>.<body style=.margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif;background-color:#f4f6f9;.>.  <table width=.100%. cellpadding=.0. cellspacing=.0. style=.background-color:#f4f6f9;padding:40px 20px;.>.    <tr>.      <td align=.center.>.        <table width=.600. cellpadding=.0. cellspacing=.0. style=.background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08);.>.          <!-- Header -->.          <tr>.            <td style=.background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 100%);padding:40px 40px 30px;text-align:center;.>.              <h1 style=.color:#ffffff;margin:0;font-size:28px;font-weight:700;letter-spacing:-0.5px;.>🎫 AuraSupport</h1>.              <p style=.color:rgba(255,255,255,0.85);margin:8px 0 0;font-size:15px;.>Sistema de Soporte Inteligente</p>.            </td>.          </tr>.          <!-- Body -->.          <tr>.            <td style=.padding:40px;.>.              <h2 style=.color:#1e293b;margin:0 0 8px;font-size:22px;.>¡Tu ticket ha sido recibido!</h2>.              <p style=.color:#64748b;margin:0 0 28px;font-size:15px;line-height:1.6;.>Hola <strong>{{ $json.user_name }}</strong>, hemos recibido tu solicitud de soporte y nuestro equipo la revisará pronto.</p>..              <!-- Ticket Card -->.              <table width=.100%. cellpadding=.0. cellspacing=.0. style=.background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0;margin-bottom:28px;.>.                <tr>.                  <td style=.padding:24px;.>.                    <table width=.100%. cellpadding=.0. cellspacing=.0.>.                      <tr>.                        <td style=.padding:6px 0;.>.                          <span style=.color:#94a3b8;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;font-weight:600;.>ID del Ticket</span><br>.                          <span style=.color:#1e293b;font-size:14px;font-weight:600;font-family:monospace;.>#{{ $json.ticket_id.substring(0, 8) }}</span>.                        </td>.                        <td style=.padding:6px 0;. align=.right.>.                          <span style=.background:{{ $json.priority === 'critical' ? '#fee2e2' : $json.priority === 'high' ? '#fef3c7' : $json.priority === 'medium' ? '#dbeafe' : '#dcfce7' }};color:{{ $json.priority === 'critical' ? '#dc2626' : $json.priority === 'high' ? '#d97706' : $json.priority === 'medium' ? '#2563eb' : '#16a34a' }};padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700;text-transform:uppercase;.>{{ $json.priority }}</span>.                        </td>.                      </tr>.                      <tr>.                        <td colspan=.2. style=.padding:16px 0 6px;border-top:1px solid #e2e8f0;.>.                          <span style=.color:#94a3b8;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;font-weight:600;.>Título</span><br>.                          <span style=.color:#1e293b;font-size:15px;font-weight:500;.>{{ $json.title }}</span>.                        </td>.                      </tr>.                      <tr>.                        <td colspan=.2. style=.padding:12px 0 6px;.>.                          <span style=.color:#94a3b8;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;font-weight:600;.>Categoría</span><br>.                          <span style=.color:#1e293b;font-size:14px;.>{{ $json.category }}</span>.                        </td>.                      </tr>.                      <tr>.                        <td colspan=.2. style=.padding:12px 0 6px;.>.                          <span style=.color:#94a3b8;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;font-weight:600;.>Fecha de creación</span><br>.                          <span style=.color:#1e293b;font-size:14px;.>{{ $json.created_at }}</span>.                        </td>.                      </tr>.                    </table>.                  </td>.                </tr>.              </table>..              <!-- CTA Button -->.              <table width=.100%. cellpadding=.0. cellspacing=.0.>.                <tr>.                  <td align=.center. style=.padding-bottom:28px;.>.                    <a href=.{{ $json.app_url }}/tickets/{{ $json.ticket_id }}. style=.display:inline-block;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#ffffff;text-decoration:none;padding:14px 32px;border-radius:8px;font-size:15px;font-weight:600;letter-spacing:0.2px;.>📋 Ver mi Ticket</a>.                  </td>.                </tr>.              </table>..              <p style=.color:#94a3b8;font-size:13px;line-height:1.6;margin:0;.>Si no creaste este ticket, puedes ignorar este email. Para cualquier consulta, responde a este correo.</p>.            </td>.          </tr>.          <!-- Footer -->.          <tr>.            <td style=.background:#f8fafc;padding:24px 40px;border-top:1px solid #e2e8f0;text-align:center;.>.              <p style=.color:#94a3b8;font-size:12px;margin:0;.>© {{ new Date().getFullYear() }} AuraSupport · Sistema de Soporte con IA</p>.              <p style=.color:#cbd5e1;font-size:11px;margin:6px 0 0;.>Este es un mensaje automático, por favor no respondas directamente.</p>.            </td>.          </tr>.        </table>.      </td>.    </tr>.  </table>.</body>.</html>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "send-email",
      "name": "Enviar Email de Confirmación",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-credentials",
          "name": "Gmail AuraSupport"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Email enviado correctamente', ticket_id: $('Parsear Payload').first().json.ticket_id }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "success-response",
      "name": "Respuesta Exitosa",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Recibir Webhook": {
      "main": [
        [
          {
            "node": "Validar Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Secret": {
      "main": [
        [
          {
            "node": "Parsear Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respuesta No Autorizada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parsear Payload": {
      "main": [
        [
          {
            "node": "Enviar Email de Confirmación",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Email de Confirmación": {
      "main": [
        [
          {
            "node": "Respuesta Exitosa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    {
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "id": "tag-aura-support",
      "name": "AuraSupport"
    }
  ],
