      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "high-priority"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst priorityEmoji = {\n  critical: '🔴',\n  high: '🟠',\n  medium: '🟡',\n  low: '🟢'\n};\n\nconst sentimentEmoji = {\n  angry: '😡',\n  negative: '😞',\n  neutral: '😐',\n  positive: '😊'\n};\n\nconst ticket = body.ticket || body;\n\nreturn [{\n  json: {\n    ticket_id: ticket.id || ticket.ticket_id || 'N/A',\n    ticket_short: (ticket.id || ticket.ticket_id || 'N/A').substring(0, 8),\n    title: ticket.title || 'Sin título',\n    priority: ticket.priority || 'high',\n    priority_emoji: priorityEmoji[ticket.priority] || '🟠',\n    sentiment: ticket.sentiment || 'neutral',\n    sentiment_emoji: sentimentEmoji[ticket.sentiment] || '😐',\n    summary: ticket.summary || ticket.ai_summary || 'Sin resumen disponible',\n    risk_level: ticket.riskLevel || ticket.risk_level || 'medium',\n    creator_email: ticket.creator_email || ticket.user_email || '',\n    created_at: new Date().toLocaleString('es-ES', { timeZone: 'America/New_York' }),\n    app_url: 'https://ai-support-ticket-system-lac.vercel.app'\n  }\n}];"
      },
      "id": "2",
      "name": "Preparar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "sendTo": "=rafaelkstro@gmail.com",
        "subject": "=🚨 ALERTA: Ticket {{ $json.priority === 'critical' ? 'CRÍTICO' : 'Alta Prioridad' }} - {{ $json.title }}",
        "emailType": "html",
        "message": "=ALERTA {{ $json.priority === 'critical' ? 'CRITICO' : 'ALTA PRIORIDAD' }}: {{ $json.title }}. Prioridad: {{ $json.priority_emoji }} {{ $json.priority }}. Sentimiento: {{ $json.sentiment_emoji }} {{ $json.sentiment }}. Resumen IA: {{ $json.summary }}. Atencion requerida en: {{ $json.app_url }}/tickets/{{ $json.ticket_id }}",
        "html": "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"></head><body style=\"margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif;background-color:#f0f2f5;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f0f2f5;padding:40px 20px;\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);\"><tr><td style=\"background:linear-gradient(135deg,#dc2626 0%,#b91c1c 100%);padding:36px 40px;text-align:center;\"><div style=\"font-size:48px;margin-bottom:8px;\">🚨</div><h1 style=\"color:#fff;margin:0;font-size:24px;font-weight:700;\">Ticket de Alta Prioridad</h1><p style=\"color:rgba(255,255,255,0.85);margin:8px 0 0;font-size:14px;\">Requiere atención inmediata</p></td></tr><tr><td style=\"padding:36px 40px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fef2f2;border:2px solid #fca5a5;border-radius:12px;margin-bottom:24px;\"><tr><td style=\"padding:20px 24px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td colspan=\"2\" style=\"padding-bottom:12px;\"><span style=\"font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#dc2626;\">Título</span><br><span style=\"font-size:17px;font-weight:600;color:#1e293b;\">{{ $json.title }}</span></td></tr><tr><td style=\"padding:8px 0;width:50%;\"><span style=\"font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.6px;font-weight:600;\">Prioridad</span><br><span style=\"font-size:14px;font-weight:700;color:#dc2626;\">{{ $json.priority_emoji }} {{ $json.priority.toUpperCase() }}</span></td><td style=\"padding:8px 0;\"><span style=\"font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.6px;font-weight:600;\">Sentimiento</span><br><span style=\"font-size:14px;font-weight:600;color:#1e293b;\">{{ $json.sentiment_emoji }} {{ $json.sentiment }}</span></td></tr><tr><td colspan=\"2\" style=\"padding-top:12px;border-top:1px solid #fca5a5;\"><span style=\"font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.6px;font-weight:600;\">Resumen IA</span><br><span style=\"font-size:13px;color:#475569;line-height:1.5;\">{{ $json.summary }}</span></td></tr><tr><td colspan=\"2\" style=\"padding-top:12px;\"><span style=\"font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.6px;font-weight:600;\">Nivel de Riesgo</span><br><span style=\"font-size:13px;color:#dc2626;font-weight:600;\">⚠️ {{ $json.risk_level.toUpperCase() }}</span></td></tr></table></td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding-bottom:24px;\"><a href=\"{{ $json.app_url }}/tickets/{{ $json.ticket_id }}\" style=\"display:inline-block;background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;text-decoration:none;padding:14px 36px;border-radius:10px;font-size:15px;font-weight:700;\">🚨 Atender Ticket Ahora</a></td></tr></table><p style=\"color:#94a3b8;font-size:12px;text-align:center;\">Ticket ID: {{ $json.ticket_short }} · {{ $json.created_at }}</p></td></tr><tr><td style=\"background:#f8fafc;padding:20px 40px;border-top:1px solid #e2e8f0;text-align:center;\"><p style=\"color:#94a3b8;font-size:12px;margin:0;\">© 2025 AuraSupport · Alerta Automática</p></td></tr></table></td></tr></table></body></html>",
        "options": {
          "appendAttribution": false
        }
      },
